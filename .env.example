# Server-only secret. Never prefix this with VITE_ or package it into Android.
GEMINI_API_KEY=

# Public client configuration. These values identify the Supabase project;
# authorization still depends on the signed-in user and database RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required for native Android AI features because the APK has no Express server.
# Use the deployed HTTPS origin that serves this repository's /api routes.
VITE_API_BASE_URL=https://nanaspork.ai.studio

# Optional server allowlist for native WebView origins. Comma-separated.
NATIVE_API_ORIGINS=https://localhost,capacitor://localhost
